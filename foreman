#!/usr/bin/env python3
"""foreman - dispatch spec'd implementation work to OpenCode, then verify it.

Your orchestrator keeps the plan and the verdict. An OpenCode model writes the
code, in its own git worktree, under write rules the server enforces. Nothing
is believed until its acceptance checks pass.

Standard library only. No dependencies.
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = os.environ.get("FOREMAN_URL", "http://127.0.0.1:4096")
STATE_DIR = os.path.expanduser(
    os.environ.get("FOREMAN_STATE", "~/.local/state/opencode-foreman")
)
TASKS_FILE = os.path.join(STATE_DIR, "tasks.json")
PID_FILE = os.path.join(STATE_DIR, "server.pid")
WORKTREE_DIR = os.path.join(STATE_DIR, "worktrees")

# Rungs, weakest first. Escalating is re-dispatching at the next one.
LADDER = ["flash", "pro", "max"]
PROFILES = {
    "flash": ("opencode-go", "deepseek-v4-flash"),   # bulk, mechanical, search
    "pro": ("opencode-go", "deepseek-v4-pro"),       # default implementation
    "max": ("opencode-go", "grok-4.5"),              # hardest tasks
}
DEFAULT_PROFILE = "pro"

# Seconds after dispatch during which "not busy" means "has not started yet".
STARTUP_GRACE = 5.0

# Commands that talk to the server. `diff`, `verify` and `clean` do not.
NEEDS_SERVER = {"dispatch", "ls", "wait", "result", "abort"}


def die(message: str, code: int = 1):
    print(f"foreman: {message}", file=sys.stderr)
    raise SystemExit(code)


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------

def auth_header(req: urllib.request.Request):
    password = os.environ.get("OPENCODE_SERVER_PASSWORD")
    if password:
        import base64
        user = os.environ.get("OPENCODE_SERVER_USERNAME", "opencode")
        token = base64.b64encode(f"{user}:{password}".encode()).decode()
        req.add_header("Authorization", f"Basic {token}")


def request(method: str, path: str, *, query: dict | None = None,
            body: dict | None = None, base: str = DEFAULT_URL, timeout: int = 600):
    url = base.rstrip("/") + path
    if query:
        url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    auth_header(req)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode()
    except urllib.error.HTTPError as exc:
        die(f"{method} {path} -> HTTP {exc.code}: {exc.read().decode(errors='replace')[:500]}")
    except urllib.error.URLError as exc:
        die(f"cannot reach opencode server at {base} ({exc.reason})")
    if not raw.strip():
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        return raw


# --------------------------------------------------------------------------
# server lifecycle - started on demand, never by hand
# --------------------------------------------------------------------------

def probe_health(base: str, timeout: int = 3):
    try:
        req = urllib.request.Request(base.rstrip("/") + "/global/health")
        auth_header(req)
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode())
    except Exception:
        return None


def ensure_server(base: str):
    if probe_health(base):
        return
    if os.environ.get("FOREMAN_AUTOSTART", "1") == "0":
        die(f"no opencode server at {base} and FOREMAN_AUTOSTART=0")
    if (urllib.parse.urlparse(base).hostname or "") not in ("127.0.0.1", "localhost", "::1"):
        die(f"no opencode server at {base}; it is remote, start it there")
    if not shutil.which("opencode"):
        die("opencode is not on PATH (https://opencode.ai)")

    os.makedirs(STATE_DIR, exist_ok=True)
    log = open(os.path.join(STATE_DIR, "server.log"), "ab")
    proc = subprocess.Popen(
        ["opencode", "serve", "--port", str(urllib.parse.urlparse(base).port or 4096),
         "--hostname", "127.0.0.1"],
        stdout=log, stderr=log, start_new_session=True,
    )
    with open(PID_FILE, "w") as handle:
        handle.write(str(proc.pid))
    for _ in range(40):
        time.sleep(0.5)
        health = probe_health(base, timeout=2)
        if health:
            print(f"started opencode {health.get('version')} at {base} (pid {proc.pid})",
                  file=sys.stderr)
            return
    die("server did not become healthy in 20s; see " + os.path.join(STATE_DIR, "server.log"))


def cmd_down(args):
    try:
        with open(PID_FILE) as handle:
            pid = int(handle.read().strip())
    except (FileNotFoundError, ValueError):
        die("no server pid recorded (foreman did not start it)")
    try:
        os.kill(pid, 15)
        print(f"stopped pid {pid}")
    except ProcessLookupError:
        print(f"pid {pid} was not running")
    os.remove(PID_FILE)


# --------------------------------------------------------------------------
# task state
# --------------------------------------------------------------------------

def load_tasks() -> dict:
    try:
        with open(TASKS_FILE) as handle:
            return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_tasks(tasks: dict):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = TASKS_FILE + ".tmp"
    with open(tmp, "w") as handle:
        json.dump(tasks, handle, indent=2)
    os.replace(tmp, TASKS_FILE)


def resolve(ref: str) -> dict:
    tasks = load_tasks()
    if not tasks:
        die("no tasks recorded yet")
    if ref in ("last", "-"):
        return max(tasks.values(), key=lambda t: t["created"])
    if ref in tasks:
        return tasks[ref]
    for task in tasks.values():
        if task["session"].endswith(ref):
            return task
    die(f"unknown task {ref!r} (try: foreman ls)")


def next_id(tasks: dict) -> str:
    used = {int(k[1:]) for k in tasks if k[1:].isdigit()}
    n = 1
    while n in used:
        n += 1
    return f"t{n}"


# --------------------------------------------------------------------------
# permission rules
#
# Verified against opencode 1.18.10; see docs/api-notes.md. Two rule forms are
# accepted and silently ignored: the permission name must be "edit" (not the
# tool name "write"), and the matcher does not honour "**/dir/**" or absolute
# prefixes. Both fail open, so normalize rather than trust what was typed.
# --------------------------------------------------------------------------

def normalize_pattern(pattern: str) -> str:
    core = pattern.strip()
    for prefix in ("**/", "*/"):
        while core.startswith(prefix):
            core = core[len(prefix):]
    for suffix in ("/**", "/*", "**", "*"):
        while core.endswith(suffix):
            core = core[: -len(suffix)]
    core = core.strip("/")
    return f"*{core}*" if core else "**"


def build_ruleset(deny: list[str], allow_bash: bool, read_only: bool) -> list[dict]:
    rules = []
    if read_only:
        rules.append({"permission": "edit", "pattern": "**", "action": "deny"})
    if not allow_bash:
        rules.append({"permission": "bash", "pattern": "**", "action": "deny"})
    for pattern in deny:
        rules.append({"permission": "edit", "pattern": normalize_pattern(pattern),
                      "action": "deny"})
    return rules


# --------------------------------------------------------------------------
# git
# --------------------------------------------------------------------------

def git(*args, cwd: str, check: bool = True) -> str:
    proc = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)
    if check and proc.returncode != 0:
        die(f"git {' '.join(args)} failed: {proc.stderr.strip()}")
    return proc.stdout


def make_worktree(repo: str, name: str) -> str:
    root = git("rev-parse", "--show-toplevel", cwd=repo).strip()
    os.makedirs(WORKTREE_DIR, exist_ok=True)
    path = os.path.join(WORKTREE_DIR, name)
    if os.path.exists(path):
        die(f"worktree {path} already exists (foreman clean it first)")
    git("worktree", "add", "-b", f"foreman/{name}", path, "HEAD", cwd=root)
    return path


# --------------------------------------------------------------------------
# commands
# --------------------------------------------------------------------------

def cmd_dispatch(args):
    prompt = open(args.file).read() if args.file else args.prompt
    if not prompt or not prompt.strip():
        die("empty prompt")

    if args.model:
        if "/" not in args.model:
            die("--model must be provider/model, e.g. opencode-go/deepseek-v4-pro")
        provider, model = args.model.split("/", 1)
    else:
        provider, model = PROFILES[args.profile]

    source = os.path.abspath(args.dir)
    tasks = load_tasks()
    task_id = next_id(tasks)
    name = task_id if args.worktree == "" else args.worktree
    workdir = make_worktree(source, name) if name else source

    ruleset = build_ruleset(args.deny, args.allow_bash, args.read_only)
    title = prompt.strip().splitlines()[0][:60]
    payload = {"title": title}
    if ruleset:
        payload["permission"] = ruleset

    sid = request("POST", "/session", query={"directory": workdir},
                  body=payload, base=args.url)["id"]
    request("POST", f"/session/{sid}/prompt_async", query={"directory": workdir},
            body={"model": {"providerID": provider, "modelID": model},
                  "parts": [{"type": "text", "text": prompt}]},
            base=args.url)

    tasks[task_id] = {
        "id": task_id, "session": sid, "dir": workdir, "source": source,
        "worktree": name, "model": f"{provider}/{model}", "title": title,
        "created": time.time(), "checks": list(args.check),
    }
    save_tasks(tasks)

    print(f"{task_id}  {sid}")
    print(f"  model     {provider}/{model}")
    print(f"  dir       {workdir}")
    if ruleset:
        print("  denied    " + ", ".join(f"{r['permission']}:{r['pattern']}" for r in ruleset))
    if args.check:
        print(f"  checks    {len(args.check)} acceptance command(s)")
    else:
        print("  checks    none - nothing will verify this task's output", file=sys.stderr)

    if args.wait:
        cmd_wait(argparse.Namespace(url=args.url, task=task_id, timeout=args.timeout))
        cmd_result(argparse.Namespace(url=args.url, task=task_id))
        if args.check:
            cmd_verify(argparse.Namespace(task=task_id))


def session_busy(url: str, task: dict) -> bool:
    status = request("GET", "/session/status", query={"directory": task["dir"]},
                     base=url) or {}
    return task["session"] in status


def has_replied(url: str, task: dict) -> bool:
    messages = request("GET", f"/session/{task['session']}/message",
                       query={"directory": task["dir"]}, base=url) or []
    return any(m.get("info", {}).get("role") == "assistant" for m in messages)


def task_state(url: str, task: dict) -> str:
    """running | starting | idle.

    /session/status lags prompt_async, so a freshly dispatched task reads as
    not-busy for a moment. Calling that "idle" makes callers collect nothing.
    """
    if session_busy(url, task):
        return "running"
    if time.time() - task["created"] < STARTUP_GRACE and not has_replied(url, task):
        return "starting"
    return "idle"


def cmd_ls(args):
    tasks = load_tasks()
    if not tasks:
        print("no tasks")
        return
    print(f"{'ID':<5} {'STATE':<9} {'CHK':<4} {'MODEL':<28} TITLE")
    for task in sorted(tasks.values(), key=lambda t: t["created"]):
        state = task_state(args.url, task)
        checks = str(len(task.get("checks") or []))
        print(f"{task['id']:<5} {state:<9} {checks:<4} {task['model']:<28} {task['title'][:44]}")


def cmd_wait(args):
    task = resolve(args.task)
    deadline = time.time() + args.timeout
    delay = 0.3
    while time.time() < deadline:
        if task_state(args.url, task) == "idle":
            print("idle")
            return
        # Tight at first so short tasks are not padded, then back off.
        time.sleep(delay)
        delay = min(delay * 1.5, 5.0)
    die(f"still running after {args.timeout}s", code=4)


def cmd_result(args):
    task = resolve(args.task)
    messages = request("GET", f"/session/{task['session']}/message",
                       query={"directory": task["dir"]}, base=args.url) or []
    texts = [part.get("text", "")
             for message in messages
             if message.get("info", {}).get("role") == "assistant"
             for part in message.get("parts", [])
             if part.get("type") == "text" and part.get("text")]
    print(texts[-1] if texts else "(no assistant text)")


def cmd_diff(args):
    task = resolve(args.task)
    # The API's /session/{id}/diff omitted untracked new files in testing, so
    # read the truth from git. intent-to-add surfaces them without staging.
    git("add", "-AN", ".", cwd=task["dir"], check=False)
    out = git("diff", cwd=task["dir"], check=False)
    print(out if out.strip() else "(no changes)")


def cmd_verify(args):
    """Run the acceptance checks. The executor's 'Done.' is a claim; this is
    the evidence. Non-zero exit if any check fails."""
    task = resolve(args.task)
    checks = task.get("checks") or []
    if not checks:
        die(f"{task['id']} has no acceptance checks; it cannot be verified")
    failed = []
    for command in checks:
        proc = subprocess.run(command, shell=True, cwd=task["dir"],
                              capture_output=True, text=True)
        ok = proc.returncode == 0
        print(f"[{'PASS' if ok else 'FAIL'}] {command}")
        if not ok:
            failed.append(command)
            for line in (proc.stdout + proc.stderr).strip().splitlines()[-8:]:
                print(f"       {line}")
    print(f"{len(checks) - len(failed)}/{len(checks)} passed")
    if failed:
        raise SystemExit(1)


def cmd_abort(args):
    task = resolve(args.task)
    request("POST", f"/session/{task['session']}/abort",
            query={"directory": task["dir"]}, base=args.url)
    print("aborted")


def cmd_clean(args):
    tasks = load_tasks()
    task = resolve(args.task)
    if task.get("worktree"):
        git("worktree", "remove", "--force", task["dir"], cwd=task["source"], check=False)
        git("branch", "-D", f"foreman/{task['worktree']}", cwd=task["source"], check=False)
        print(f"removed worktree {task['dir']}")
    tasks.pop(task["id"], None)
    save_tasks(tasks)
    print(f"forgot {task['id']}")


# --------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="foreman",
        description="Dispatch spec'd implementation work to OpenCode, then verify it.")
    parser.add_argument("--url", default=DEFAULT_URL)
    sub = parser.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("dispatch", help="send a task to an executor session")
    d.add_argument("prompt", nargs="?", help="the task, self-contained")
    d.add_argument("-f", "--file", help="read the prompt from a file instead")
    d.add_argument("--dir", default=".", help="repository to work in")
    d.add_argument("--worktree", nargs="?", const="", default=None, metavar="NAME",
                   help="run in an isolated git worktree (default name: task id)")
    d.add_argument("--check", action="append", default=[], metavar="CMD",
                   help="acceptance command; must exit 0 (repeatable)")
    d.add_argument("--profile", choices=LADDER, default=DEFAULT_PROFILE,
                   help=f"ladder rung: {' -> '.join(LADDER)} (default {DEFAULT_PROFILE})")
    d.add_argument("--model", help="pin provider/model, overrides --profile")
    d.add_argument("--deny", action="append", default=[], metavar="PATH",
                   help="deny edits under this path (repeatable)")
    d.add_argument("--read-only", action="store_true", help="deny all edits")
    d.add_argument("--allow-bash", action="store_true",
                   help="permit shell commands (denied by default)")
    d.add_argument("--wait", action="store_true",
                   help="block, print the result, then run the checks")
    d.add_argument("--timeout", type=int, default=1800)
    d.set_defaults(fn=cmd_dispatch)

    sub.add_parser("ls", help="tasks, live state, and how many checks each carries"
                   ).set_defaults(fn=cmd_ls)
    sub.add_parser("down", help="stop the server foreman started").set_defaults(fn=cmd_down)

    for name, fn, helptext in [
        ("wait", cmd_wait, "block until the session goes idle"),
        ("result", cmd_result, "the executor's final message"),
        ("diff", cmd_diff, "git diff of what the executor changed"),
        ("verify", cmd_verify, "run the acceptance checks"),
        ("abort", cmd_abort, "stop a running session"),
        ("clean", cmd_clean, "remove the worktree and forget the task"),
    ]:
        p = sub.add_parser(name, help=helptext)
        p.add_argument("task", nargs="?", default="last", help="task id (default: last)")
        if name == "wait":
            p.add_argument("--timeout", type=int, default=1800)
        p.set_defaults(fn=fn)

    args = parser.parse_args()
    if args.cmd in NEEDS_SERVER:
        ensure_server(args.url)
    args.fn(args)


if __name__ == "__main__":
    main()
